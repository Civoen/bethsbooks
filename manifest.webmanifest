    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add a book", "short_name": "Add", "url": "./#/add", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My books", "short_name": "Books", "url": "./#/books", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
