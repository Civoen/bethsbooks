{
  "name": "Beth's Books",
  "short_name": "Beth's Books",
  "description": "Beth's personal reading library and tracker.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#B83A68",
